# data: fetched by `python -m marketplace_recs.data`, never committed
data/
# serving artifacts built by `python -m marketplace_recs.online export`; derived from the data
model/*
!model/.gitkeep

# python
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
uv.lock

# editors / os
.vscode/
.idea/
Thumbs.db
.DS_Store
loadtest/sessions.json
loadtest/*.out.json

# terraform: state and the real variables stay on the machine that applies them
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
